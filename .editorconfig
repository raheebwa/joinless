# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# PEP 8.
[*.py]
indent_size = 4

# Two trailing spaces are a hard line break in Markdown, so stripping them
# changes rendered output.
[*.md]
trim_trailing_whitespace = false
